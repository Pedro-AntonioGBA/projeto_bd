package br.edu.ifpb.bd.projeto.dao;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.List;

import org.springframework.stereotype.Repository;

import br.edu.ifpb.bd.projeto.model.Prato;
import br.edu.ifpb.bd.projeto.util.ConnectionFactory;
import br.edu.ifpb.bd.projeto.dto.PratoIngredienteDTO;

@Repository
public class PratoDAO {
    
    public List<Prato> listar() throws Exception {
        List<Prato> lista = new ArrayList<>();
        String sql = "SELECT * FROM pratos";
        try (Connection c = ConnectionFactory.getConnection();
             Statement st = c.createStatement();
             ResultSet rs = st.executeQuery(sql)) {
             while (rs.next()) {
                   lista.add(new Prato(
                           rs.getInt("id_prato"),
                           rs.getString("receita"),
                           rs.getFloat("valor"),
                           rs.getBoolean("disponibilidade")
                   ));
             }
        }
        return lista;
    }
}

 public List<PratoIngredienteDTO> listarPratosIngredientes() throws Exception {
     List<PratoIngredienteDTO> lista = new ArrayList<>();
     String sql = "SELECT p.receita, i.nome AS ingrediente, i.valor " +
                  "FROM pratos p " +
                  "INNER JOIN ingredientes_prato ip ON p.id_prato = ip.id_prato " +
                  "INNER JOIN ingredientes i ON ip.id_ingrediente = i.id_ingrediente " +
                  "WHERE p.receita LIKE 'Bolo%' AND i.valor > 5.0";
     try (Connection c = ConnectionFactory.getConnection();
          Statement st = c.createStatement();
          ResultSet rs = st.executeQuery(sql)) {
          while (rs.next()) {
                lista.add(new PratoIngredienteDTO(
                        rs.getString("receita"),
                        rs.getString("ingrediente"),
                        rs.getFloat("valor")
                ));
          }
     }
     return lista;
 }