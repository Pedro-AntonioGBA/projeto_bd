     public List<FornecedorTotalDTO> listarTotalIngredientes() throws Exception {
         List<FornecedorTotalDTO> lista = new ArrayList<>();
         String sql = "SELECT f.nome AS fornecedor, COUNT(i.id_ingrediente) AS total_ingredientes " +
                      "FROM fornecedores f " +
                      "INNER JOIN ingredientes i ON f.id_fornecedor = i.id_fornecedor " +
                      "GROUP BY f.id_fornecedor, f.nome " +
                      "ORDER BY total_ingredientes DESC";
         try (Connection c = ConnectionFactory.getConnection();
              Statement st = c.createStatement();
              ResultSet rs = st.executeQuery(sql)) {
              while (rs.next()) {
                    lista.add(new FornecedorTotalDTO(
                            rs.getString("fornecedor"),
                            rs.getInt("total_ingredientes")
                    ));
              }
         }
         return lista;
     }


    public void excluir(Integer id) throws Exception {
        String sql = "DELETE FROM fornecedores WHERE id_fornecedor=?";
        try (Connection c = ConnectionFactory.getConnection();
             PreparedStatement ps = c.prepareStatement(sql)) {
            ps.setInt(1, id);
            ps.execute();
        }
    }
}